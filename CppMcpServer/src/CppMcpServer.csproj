<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CppMcpServer</RootNamespace>
    <AssemblyName>CppMcpServer</AssemblyName>
    
    <!-- VSIX Properties for the new Extensibility Model -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ExtensionDeploymentMode>Dynamic</ExtensionDeploymentMode>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Core Extensibility SDK - Includes build targets for VSIX generation -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility" Version="17.13.2060" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.13.40008">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- MCP Server Dependencies -->
    <PackageReference Include="ModelContextProtocol" Version="0.1.0-preview.5" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- VSIX Manifest -->
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  
</Project>
